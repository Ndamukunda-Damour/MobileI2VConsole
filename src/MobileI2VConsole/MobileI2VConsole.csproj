<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>MobileI2VConsole</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>MobileI2V</ApplicationTitle>
    <ApplicationId>com.mobilei2v.console</ApplicationId>
    <ApplicationDisplayVersion>1.0.2</ApplicationDisplayVersion>
    <ApplicationVersion>3</ApplicationVersion>

    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>

    <!-- Work around .NET 10 Android Release startup failures involving generated marshal methods. -->
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <!-- Make Release APK self-contained; avoid debug-style fast deployment paths. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidFastDeployment>false</AndroidFastDeployment>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appicon.svg" Color="#1A1A2E" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1A1A2E" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\Raw\PromptTemplates.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.80" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.Maui" Version="14.2.0" />
    <PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="10.0.0" />
    <PackageReference Include="SkiaSharp" Version="4.148.0" />
  </ItemGroup>

  <!-- Prevent Linux/glibc ONNX assets from replacing the Android/Bionic native library. -->
  <Target Name="RemoveLinuxOnnxNativeAssets"
          Condition="'$(TargetFramework)' == 'net10.0-android'"
          AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)"
          Condition="$([System.String]::Copy('%(NativeCopyLocalItems.PathInPackage)').Contains('runtimes/linux-'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="$([System.String]::Copy('%(ResolvedFileToPublish.PathInPackage)').Contains('runtimes/linux-'))" />
    </ItemGroup>
  </Target>

</Project>
